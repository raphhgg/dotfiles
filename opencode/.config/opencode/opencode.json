{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.3-codex",
    "agent": {
        "build": {
            "model": "openai/gpt-5.3-codex"
        },
        "plan": {
            "model": "openai/gpt-5.3-codex"
        }
    },
    "permission": {
        "read": "allow",
        "list": "allow",
        "glob": "allow",
        "grep": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": {
            // Ask
            "*": "ask",
            "rm -rf*": "ask",
            "rm*": "ask",
            "sudo*": "ask",

            // Allow
            "cat*": "allow",
            "date*": "allow",
            "echo*": "allow",
            "grep*": "allow",
            "sed*": "allow",
            "uniq*": "allow",
            "xargs*": "allow",
            "head*": "allow",
            "find*": "allow",
            "ls*": "allow",
            "sort*": "allow",
            "curl*": "allow",
            "dmesg*": "allow",
            "docker events*": "allow",
            "docker inspect*": "allow",
            "docker logs*": "allow",
            "docker ps*": "allow",
            "docker compose -f*": "allow",
            "docker compose config*": "allow",
            "docker compose logs*": "allow",
            "sleep*": "allow",
            "git diff*": "allow",
            "git log*": "allow",
            "git add*": "allow",
            "git commit*": "allow",
            "git rm*": "allow",
            "git status*": "allow",
            "git branch*": "allow",
            "git ls-files*": "allow",
            "git show*": "allow",
            "gemini*": "allow",
            "journalctl*": "allow",
            "ping*": "allow",
            "rg*": "allow",
            "test*": "allow",
            "stow*": "allow",
            "stat*": "allow",
            "wc*": "allow"
        },
        "edit": "ask",
        "write": "ask",
        "external_directory": {
            "*": "ask",
            "/home/raphh/docker/appdata/*": "allow"
        }
    },
    "instructions": ["CLAUDE.md", "AGENTS.md"],
    "compaction": {
        "keep_tokens": 8192
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp"
        },
        "grep": {
            "type": "remote",
            "url": "https://mcp.grep.app"
        },
        "exa": {
            "type": "remote",
            "url": "https://mcp.exa.ai/mcp"
        }
    },
    "plugin": ["@franlol/opencode-md-table-formatter@0.0.3"],
    "provider": {
        "local-llama": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Llama Server",
            "options": {
                "baseURL": "http://127.0.0.1:8081/v1",
                "apiKey": "x"
            },
            "models": {
                "nemotron-3-nano-30b-a3b-q4": {
                    "name": "Nemotron-3-Nano Q4",
                    "description": "32B MoE (4B active) Q4 — 175 t/s — Speed: autocomplete, chat, quick tasks",
                    "limit": {
                        "context": 65536,
                        "output": 16384
                    }
                },
                "nemotron-3-nano-30b-a3b-q6": {
                    "name": "Nemotron-3-Nano Q6",
                    "description": "32B MoE (4B active) Q6 — 75 t/s — Daily driver: agentic coding, tool calling",
                    "limit": {
                        "context": 131072,
                        "output": 16384
                    }
                },
                "glm-4.7-flash-q6": {
                    "name": "GLM-4.7-Flash Q6",
                    "description": "30B MoE (3B active) Q6 — 68 t/s — Hard code reasoning",
                    "limit": {
                        "context": 65536,
                        "output": 16384
                    }
                },
                "devstral-small-2-24b-q4": {
                    "name": "Devstral-Small-2 Q4",
                    "description": "24B dense code-specialized Q4 — 53 t/s — Dense coder, 163k context",
                    "limit": {
                        "context": 163840,
                        "output": 16384
                    }
                },
                "devstral-small-2-24b-q6": {
                    "name": "Devstral-Small-2 Q6",
                    "description": "24B dense code-specialized Q6 — 37 t/s — Dense coder, max quality",
                    "limit": {
                        "context": 65536,
                        "output": 16384
                    }
                },
                "qwen3-next-80b-thinking-q5": {
                    "name": "Qwen3-Next-80B Thinking Q5",
                    "description": "80B MoE (3B active) Q5 thinking-only — 38 t/s — Brainstorming, planning, reasoning",
                    "limit": {
                        "context": 262144,
                        "output": 81920
                    }
                },
                "qwen3-coder-next-q5": {
                    "name": "Qwen3-Coder-Next Q5",
                    "description": "80B MoE (3B active) Q5 — 45 t/s — Heavy coder, 80B knowledge base",
                    "limit": {
                        "context": 131072,
                        "output": 16384
                    }
                }
            }
        }
    }
}
