# macOS
.DS_Store
**/.DS_Store

# Git
.git/

# Editor
.vscode/
.cursor/

# Claude Code
# Ignore project-specific .claude directory (at root)
/.claude/
**/.secrets
**/config.local
**/*.local
ssh/.ssh/config.local
codex/.codex/config.*.local.toml
