# Git inspection rules.

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Read-only Git status inspection is safe to auto-approve.",
    match = [
        "git status",
        "git status --short",
        "git status --branch --short",
    ],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Read-only Git diff inspection is safe to auto-approve.",
    match = [
        "git diff",
        "git diff --stat",
        "git diff HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Read-only Git history inspection is safe to auto-approve.",
    match = [
        "git log",
        "git log --oneline",
        "git log --stat -5",
    ],
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "Read-only Git object inspection is safe to auto-approve.",
    match = [
        "git show HEAD",
        "git show --stat HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "remote", "-v"],
    decision = "allow",
    justification = "Inspecting configured Git remotes is safe to auto-approve.",
    match = [
        "git remote -v",
    ],
    not_match = [
        "git remote add origin git@github.com:owner/repo.git",
    ],
)
