# Go command rules.

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "Running Go tests is a routine development action to auto-approve.",
    match = [
        "go test ./...",
        "go test ./internal/application/requesters ./internal/transport/discord ./internal/infrastructure/integrations/overseerr",
        "go test -run TestName ./...",
    ],
)

prefix_rule(
    pattern = ["gofmt", "-w"],
    decision = "allow",
    justification = "Formatting Go source files in place is a routine development action to auto-approve.",
    match = [
        "gofmt -w cmd/service/main.go",
        "gofmt -w cmd/service/main.go internal/application/config/config.go",
        "gofmt -w ./cmd/service/main.go ./internal/application/config/config.go",
    ],
)
