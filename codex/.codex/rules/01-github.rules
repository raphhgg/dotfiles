# GitHub CLI-specific Codex execpolicy rules.
#
# Keep GitHub command approvals here so they can evolve independently from
# generic Git, shell, and safety rules in `00-global-backbone.rules`.

prefix_rule(
    pattern = ["gh", "auth", "status"],
    decision = "allow",
    justification = "Checking GitHub CLI auth state is safe to auto-approve.",
    match = [
        "gh auth status",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", "list"],
    decision = "allow",
    justification = "Listing GitHub issues is safe to auto-approve.",
    match = [
        "gh issue list",
        "gh issue list --limit 20",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", "view"],
    decision = "allow",
    justification = "Viewing GitHub issues is safe to auto-approve.",
    match = [
        "gh issue view 123",
        "gh issue view 123 --comments",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", "close"],
    decision = "allow",
    justification = "Closing GitHub issues is an intentional user-requested write action to auto-approve.",
    match = [
        "gh issue close 123",
        "gh issue close 123 --comment done",
        "gh issue close 123 --reason completed",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "Viewing pull requests is safe to auto-approve.",
    match = [
        "gh pr view 123",
        "gh pr view 123 --comments",
        "gh pr view 123 --json title,body,comments",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "edit"],
    decision = "allow",
    justification = "Editing pull request metadata is a routine intentional write action to auto-approve.",
    match = [
        "gh pr edit 123 --title New title",
        "gh pr edit 123 --body Updated body",
        "gh pr edit 123 --add-label ready-for-review",
        "gh pr edit 123 --remove-label blocked",
    ],
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "allow",
    justification = "Querying GitHub repository API endpoints through the GitHub CLI is a routine inspection action to auto-approve.",
    match = [
        "gh api repos/owner/repo",
        "gh api repos/owner/repo/pulls",
        "gh api repos/owner/repo/issues",
        "gh api repos/owner/repo/contents/path/to/file",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", "create", "--repo"],
    decision = "allow",
    justification = "Creating issues in the shared agent-standards repo from another workspace is an intentional routine write action to auto-approve.",
    match = [
        "gh issue create --repo raaphhh/agent-standards --title Example --body Example",
        "gh issue create --repo raaphhh/agent-standards --title Example --body-file /tmp/body.md",
        "gh issue create --repo raaphhh/agent-standards --title Example --label triage",
    ],
)
