# Low-risk shell inspection rules.

prefix_rule(
    pattern = ["pwd"],
    decision = "allow",
    justification = "Printing the current directory is safe to auto-approve.",
    match = [
        "pwd",
    ],
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "Listing directory entries is safe to auto-approve.",
    match = [
        "ls",
        "ls -la",
        "ls -la $HOME/Projects/homelab-notifications-hub",
    ],
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "Reading file contents is a low-risk inspection action to auto-approve.",
    match = [
        "cat AGENTS.md",
        "cat $HOME/dotfiles/codex/.codex/config.toml",
    ],
)

prefix_rule(
    pattern = ["perl", "-0pi"],
    decision = "allow",
    justification = "In-place config maintenance with an explicit Perl edit pattern is an intentional local write action to auto-approve.",
    match = [
        "perl -0pi -e 's/foo/bar/' /tmp/example.txt",
    ],
)
