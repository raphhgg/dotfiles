# Theme
# theme = Catppuccin Mocha
theme = TokyoNight Night

# Terminal
# Fallback TERM for SSH compatibility (fixes backspace issues)
# term = xterm-256color

# Enable SSH shell integration features
shell-integration-features = ssh-env

# Fonts
# font-family = CaskaydiaCove Nerd Font
# font-family = Meslo LGS Nerd Font Mono
# font-family = CaskaydiaMono Nerd Font
# font-family = CaskaydiaCove Nerd Font
font-family = JetBrainsMono Nerd Font
font-size = 14

# Background
background-opacity = 0.9
background-blur-radius = 10

# Title bar
gtk-titlebar = false
macos-titlebar-style = hidden

# Window
window-decoration = true
window-width = 140
window-height = 50
window-padding-x = 12
window-padding-y = 12

# Mouse
mouse-hide-while-typing = true

# Copy & Paste
copy-on-select = clipboard
clipboard-paste-protection = true
clipboard-read = allow
clipboard-write = allow
right-click-action = paste
# https://github.com/ghostty-org/ghostty/issues/3359

# Focus
# Fade unfocused splits (great for productivity)
unfocused-split-opacity = 0.7

# Focus follows mouse for splits
focus-follows-mouse = true

# ==== DEFAULT - USED FOR REFERENCE ==== ##

# Split Management Keybinds
# New split right - ⌘+D
keybind = super+d=new_split:right
# New split down - ⌘+Shift+D
keybind = super+shift+d=new_split:down

# Navigation
# Move to split left - ⌘+Opt+←
keybind = super+alt+left=goto_split:left
# Move to split right - ⌘+Opt+→
keybind = super+alt+right=goto_split:right
# Move to split up - ⌘+Opt+↑
keybind = super+alt+up=goto_split:up
# Move to split down - ⌘+Opt+↓
keybind = super+alt+down=goto_split:down
# Previous split - ⌘+[
keybind = super+left_bracket=goto_split:previous
# Next split - ⌘+]
keybind = super+right_bracket=goto_split:next

# Resize splits
# Resize split left by 10 - ⌘+Ctrl+←
keybind = super+ctrl+left=resize_split:left,10
# Resize split right by 10 - ⌘+Ctrl+→
keybind = super+ctrl+right=resize_split:right,10
# Resize split up by 10 - ⌘+Ctrl+↑
keybind = super+ctrl+up=resize_split:up,10
# Resize split down by 10 - ⌘+Ctrl+↓
keybind = super+ctrl+down=resize_split:down,10
# Equalize all splits - ⌘+Ctrl+=
keybind = super+ctrl+equal=equalize_splits

# Toggle split zoom (maximize) - ⌘+Shift+Enter
keybind = super+shift+enter=toggle_split_zoom

# ==== DEFAULTS END ==== ##

# Shift+Enter binding for Claude Code and terminals
# Try the VS Code compatible sequence first
keybind = shift+enter=text:\x1b\x0d

# Hyper Key Configuration
# Send F1 function key sequence for hyper key prefix
# Using A as the trigger key, sends F1 which tmux can bind to
# Hyper+A acts as tmux prefix
keybind = super+ctrl+alt+shift+a=text:\x1bOP
keybind = super+ctrl+alt+shift+f=ignore
keybind = super+ctrl+alt+shift+g=ignore
keybind = super+ctrl+alt+shift+h=ignore
keybind = super+ctrl+alt+shift+i=ignore
keybind = super+ctrl+alt+shift+j=ignore
keybind = super+ctrl+alt+shift+k=ignore
keybind = super+ctrl+alt+shift+l=ignore
keybind = super+ctrl+alt+shift+m=ignore
keybind = super+ctrl+alt+shift+n=ignore
keybind = super+ctrl+alt+shift+o=ignore
keybind = super+ctrl+alt+shift+p=ignore
keybind = super+ctrl+alt+shift+q=ignore
keybind = super+ctrl+alt+shift+r=ignore
keybind = super+ctrl+alt+shift+s=ignore
keybind = super+ctrl+alt+shift+t=ignore
keybind = super+ctrl+alt+shift+u=ignore
keybind = super+ctrl+alt+shift+v=ignore
keybind = super+ctrl+alt+shift+w=ignore
keybind = super+ctrl+alt+shift+x=ignore
keybind = super+ctrl+alt+shift+y=ignore
keybind = super+ctrl+alt+shift+z=ignore
