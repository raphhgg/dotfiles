{
  "permissions": {
    "allow": [
      "WebFetch",
      "Read",
      "Write",
      "Bash",
      "Glob",
      "LS",
      "Bash(curl:*)"
    ],
    "deny": ["Bash(rm -rf:*)"]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": false
}
