{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read(*)",
      "Glob",
      "LS",
      "Bash(curl:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(osascript:*)",
      "Bash(readlink:*)",
      "Bash(ls:*)",
      "Bash(unzip:*)",
      "Bash(python3:*)",
      "Bash(source:*)",
      "Bash(pip install:*)",
      "Bash(pgrep:*)",
      "Bash(aerospace:*)",
      "Bash(tree:*)",
      "Bash(log show:*)",
      "Bash(chmod:*)",
      "Bash(sketchybar:*)",
      "Bash(echo:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git -C *)",
      "Bash(xargs -0 git rm -f --ignore-unmatch)",
      "Skill(gemini)"
    ],
    "ask": [],
    "deny": ["Bash(rm -rf:*)"]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@latest",
    "padding": 0
  },
  "alwaysThinkingEnabled": true,
  "autoCompactEnabled": false
}
