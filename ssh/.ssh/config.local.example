# Copy this file to ~/.ssh/config.local and adapt it for your machine.

Host homelab-node
    HostName 192.168.1.10
    User your-user
    IdentityFile ~/.ssh/id_ed25519_homelab
    ForwardAgent yes
    SendEnv LANG LC_*

Host homelab-vm-tmux
    HostName 192.168.1.20
    User your-user
    RequestTTY yes
    RemoteCommand tmux -u attach || tmux new-session -s main

Host homelab-vm-notmux
    HostName 192.168.1.20
    User your-user

Host homelab-vm-codex
    HostName 192.168.1.20
    User your-user
    RequestTTY no
