Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes

Host github-aviv
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_aviv
