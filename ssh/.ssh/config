Host ds423plus
    HostName ds423plus
    User raphh
    ForwardAgent yes
    SendEnv LANG LC_*

Host ds423plus-notmux
    HostName ds423plus
    User raphh
    ForwardAgent yes
    RemoteCommand /home/linuxbrew/.linuxbrew/bin/zsh -c 'export SKIP_TMUX=1 && exec /home/linuxbrew/.linuxbrew/bin/zsh -l'
    RequestTTY yes

Host ds423plus-github-actions-dotfiles-sync
    HostName ds423plus
    User raphh
    IdentityFile ~/.ssh/github_actions_dotfiles
    IdentitiesOnly yes

Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes

Host github-aviv
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_aviv
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes
