Include /Users/raphaelgrau/.colima/ssh_config

IgnoreUnknown UseKeychain

Include ~/.ssh/config.local

Host pve
    HostName 10.10.2.4
    User root
    IdentityFile ~/.ssh/pve_root_ed25519

Host debian-vm
    HostName 10.10.2.201
    SetEnv TERM=xterm-256color
    User raphh
    IdentityFile ~/.ssh/id_ed25519_debian_vm
    ForwardAgent yes
    RequestTTY yes
    RemoteCommand tmux -u attach || tmux new-session -s main
    SendEnv LANG LC_*

Host greencloud-vps
    HostName 91.223.119.254
    SetEnv TERM=xterm-256color
    User root
    IdentityFile ~/.ssh/greencloud_vps
    ForwardAgent yes
    SendEnv LANG LC_*

Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes
    AddKeysToAgent yes

Host github-aviv
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_aviv
    IdentitiesOnly yes
    AddKeysToAgent yes
