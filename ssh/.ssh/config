Host ds423plus
    HostName ds423plus
    User raphh
    ForwardAgent yes
    SetEnv TERM=xterm-256color

Host lazydocker
    HostName ds423plus
    User raphh
    RequestTTY yes
    RemoteCommand /usr/local/bin/docker run -it --rm --name lazydocker --network socket_proxy -e DOCKER_HOST=tcp://172.26.0.22:2375 -v /volume2/docker/appdata/lazydocker:/.config/jesseduffield/lazydocker lazyteam/lazydocker && docker network connect main lazydocker

Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes

Host github-aviv
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_aviv
    IdentitiesOnly yes
    UseKeychain yes
    AddKeysToAgent yes