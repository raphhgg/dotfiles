IgnoreUnknown UseKeychain

Include ~/.ssh/config.local

Host pve
    Hostname 10.10.2.4
    User root
    IdentityFile ~/.ssh/pve_root_ed25519

Host github-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes
    AddKeysToAgent yes

Host github-aviv
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_aviv
    IdentitiesOnly yes
    AddKeysToAgent yes
