Host ds423plus
    HostName ds423plus
    SetEnv TERM=xterm-256color
    User raphh
    IdentityFile ~/.ssh/id_rsa
    ForwardAgent yes
    RequestTTY yes
    RemoteCommand PATH="/usr/local/bin:$PATH" tmux -u new-session -A -s main
    SendEnv LANG LC_*

Host ds423plus-notmux
    HostName ds423plus
    SetEnv TERM=xterm-256color
    User raphh
    IdentityFile ~/.ssh/id_rsa
    ForwardAgent yes
    RequestTTY yes
    SendEnv LANG LC_*

Host ubuntu-server
    HostName ubuntu-server
    SetEnv TERM=xterm-256color
    User raphh
    IdentityFile ~/.ssh/id_ed25519_ubuntu_server
    ForwardAgent yes
    RequestTTY yes
    RemoteCommand tmux new-session -A -s main
