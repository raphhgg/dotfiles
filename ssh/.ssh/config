Host ubuntu-server-notmux
    HostName ubuntu-server
    SetEnv TERM=xterm-256color
    User raphh
    IdentityFile ~/.ssh/id_ed25519_ubuntu_server
    ForwardAgent yes
    RequestTTY yes
